# Copy to .env and fill in real values. Never commit .env.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///classnotes.db
UPLOAD_FOLDER=uploads
FLASK_DEBUG=0
# Set to 1 behind HTTPS in production (marks session cookie Secure)
SESSION_COOKIE_SECURE=0
# Set to 1 when running behind Nginx/a reverse proxy so rate limiting sees
# real client IPs (trusts one hop of X-Forwarded-For/Proto/Host)
PROXY_FIX=0
